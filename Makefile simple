NAME = libftprintf.a

LIBFT = libft/libft.a

CC = cc

SOURCES = flag_parsing.c print_i.c print_x.c \
ft_printf.c	print_c_s.c	print_u.c \
# libft.c

OBJECTS = $(SOURCES:.c=.o)

CFLAGS = -Wall -Wextra -Werror -Ilibft

%.o: %.c
		${CC} ${CFLAGS} -c $< -o $@

all: $(NAME)

$(LIBFT):
	$(MAKE) -C libft
	
$(NAME): $(LIBFT) $(OBJECTS)
	cp $(LIBFT) $(NAME)
	ar -rcs $(NAME) $(OBJECTS)

clean: 
		rm -f $(OBJECTS)

fclean: clean
		rm -f $(NAME)

re : fclean all

.PHONY: all clean fclean re
